# The frontend requires the FastAPI backend to be running.
# Vite proxies /health, /api and /v1 to http://127.0.0.1:8000.
# Use a relative base so requests always go through the Vite proxy.
VITE_API_BASE_URL=/api/v1

# ElevenLabs Text-to-Speech (Optional high-fidelity neural voice)
# Models recommended: eleven_flash_v2_5 (50% cheaper credits, ultra-low latency)
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
VITE_ELEVENLABS_MODEL_ID=eleven_flash_v2_5
VITE_ELEVENLABS_ENABLE_CACHE=true
